# Local lab only. Copy to .env and replace each value before any shared deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-local-value
OIDC_ISSUER=http://127.0.0.1:8080/realms/accessops
OIDC_CLIENT_ID=accessops-portal
OIDC_CLIENT_SECRET=replace-portal-secret
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=accessops
KEYCLOAK_AUTOMATION_CLIENT_ID=accessops-automation
KEYCLOAK_AUTOMATION_CLIENT_SECRET=replace-automation-secret
KEYCLOAK_BOOTSTRAP_ADMIN=accessops-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=replace-bootstrap-password
JOINER_TEMPORARY_PASSWORD=Replace-Temporary-Password-2026!
ACCESSOPS_AUDIT_LOG=evidence/audit-log.jsonl

