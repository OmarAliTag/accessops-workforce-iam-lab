{
  "realm": "accessops",
  "displayName": "AccessOps Workforce IAM Lab",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {"name": "portal-user", "description": "May enter the employee portal"},
      {"name": "ticket-reader", "description": "May read synthetic helpdesk tickets"},
      {"name": "iam-admin", "description": "May view IAM administration content"},
      {"name": "auditor", "description": "May view lifecycle audit evidence"},
      {"name": "finance-requester", "description": "May create synthetic finance requests"},
      {"name": "finance-approver", "description": "May approve synthetic finance requests"},
      {"name": "operations-user", "description": "May enter the operations workspace"}
    ]
  },
  "groups": [
    {"name": "Employees", "realmRoles": ["portal-user"]},
    {"name": "Helpdesk", "realmRoles": ["ticket-reader"]},
    {"name": "IAM-Operations", "realmRoles": ["iam-admin", "auditor"]},
    {"name": "Finance-Requesters", "realmRoles": ["finance-requester"]},
    {"name": "Finance-Approvers", "realmRoles": ["finance-approver"]},
    {"name": "Operations", "realmRoles": ["operations-user"]}
  ],
  "clients": [
    {
      "clientId": "accessops-portal",
      "name": "AccessOps Portal",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ACCESSOPS_PORTAL_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://127.0.0.1:5000",
      "baseUrl": "http://127.0.0.1:5000/",
      "redirectUris": [
        "http://127.0.0.1:5000/auth/callback",
        "http://localhost:5000/auth/callback"
      ],
      "webOrigins": ["http://127.0.0.1:5000", "http://localhost:5000"],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:5000/*##http://localhost:5000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles for portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "accessops-automation",
      "name": "AccessOps Lifecycle Automation",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ACCESSOPS_AUTOMATION_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "nour.helpdesk",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nour",
      "lastName": "Haddad",
      "email": "nour.helpdesk@example.test",
      "attributes": {
        "department": ["Helpdesk"],
        "data_classification": ["synthetic"]
      },
      "groups": ["/Employees", "/Helpdesk"],
      "credentials": [
        {"type": "password", "value": "Nour-Lab-Only-2026!", "temporary": false}
      ]
    },
    {
      "username": "dina.auditor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dina",
      "lastName": "Mostafa",
      "email": "dina.auditor@example.test",
      "attributes": {
        "department": ["IAM Operations"],
        "data_classification": ["synthetic"]
      },
      "groups": ["/Employees", "/IAM-Operations"],
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {"type": "password", "value": "Dina-Lab-Only-2026!", "temporary": false}
      ]
    },
    {
      "username": "service-account-accessops-automation",
      "enabled": true,
      "serviceAccountClientId": "accessops-automation",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "query-groups"]
      }
    }
  ]
}

